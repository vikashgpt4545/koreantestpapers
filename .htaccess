# Apache rewrite rules for koreantestpapers.in
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /koreantestpapers/

    # Redirect /index.php to root clean URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(.*/)index\.php[?\s] [NC]
    RewriteRule ^(.*)index\.php$ /$1 [R=301,L]

    # Handle directory index
    DirectoryIndex index.php index.html

    # Route requests if file or directory doesn't exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9\-]+)$ pages/$1.php [L,QSA]
</IfModule>
